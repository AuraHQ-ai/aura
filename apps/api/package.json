{
  "name": "aura-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'set -a; [ -f ../../.env.local ] && . ../../.env.local; set +a; exec nitro dev'",
    "dev:node": "node --env-file=../../.env.local --import tsx --watch src/index.ts",
    "build": "tsc",
    "build:vercel": "nitro build --preset vercel && node scripts/patch-vercel-output.mjs",
    "vercel-build": "pnpm --filter @aura/db db:migrate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "content:index": "tsx scripts/index-content.ts",
    "content:index:no-embeddings": "tsx scripts/index-content.ts --skip-embeddings",
    "backfill:canonical-model-ids": "tsx scripts/backfill-canonical-model-ids.ts",
    "backfill:response-scores": "tsx src/scripts/backfill-response-scores.ts",
    "ratify:gold-set": "tsx src/scripts/ratify-gold-set.ts",
    "rebuild:memories": "tsx src/scripts/rebuild-memories.ts",
    "bench:memory": "tsx src/scripts/bench-memory.ts",
    "bench:memory:i": "tsx src/scripts/bench-memory.ts --interactive",
    "bench:fetch-corpus": "tsx bench/scripts/fetch-corpus.ts",
    "bench:report": "tsx bench/scripts/report.ts",
    "bench:inspect": "tsx bench/scripts/inspect-run.ts",
    "bench:locomo-fast": "tsx bench/scripts/build-locomo-fast.ts",
    "bench:pr-comment": "tsx bench/scripts/pr-comment.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/cohere": "^4.0.60",
    "@ai-sdk/gateway": "^4.0.111",
    "@ai-sdk/mcp": "^2.0.74",
    "@ai-sdk/provider": "^4.0.27",
    "@ai-sdk/provider-utils": "^5.0.59",
    "@aura/db": "workspace:*",
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@google-cloud/bigquery": "^9.3.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/drive": "^26.0.2",
    "@googleapis/gmail": "^22.0.1",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@inquirer/prompts": "^8.7.3",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@slack/web-api": "^8.2.0",
    "@tavily/core": "^0.7.14",
    "@vercel/functions": "^3.9.11",
    "@workflow/ai": "^5.0.3",
    "ai": "^7.0.138",
    "cron-parser": "^5.10.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "e2b": "^2.55.0",
    "google-auth-library": "^11.3.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "markdown-table-prettify": "^4.1.0",
    "nitro": "3.0.260903-beta",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "reading-time": "^1.5.0",
    "rollup": "^4.64.5",
    "turndown": "^7.2.4",
    "undici": "^7.30.0",
    "workflow": "^5.2.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
